{
  "name": "translation-harness",
  "version": "0.3.1",
  "description": "Drive non-interactive coding-agent CLIs as resumable, guardrailed translation workers over a structured corpus, then review what they produced.",
  "keywords": [
    "translation",
    "localization",
    "review",
    "agent",
    "codex",
    "claude",
    "batch",
    "resumable",
    "subprocess",
    "llm"
  ],
  "author": "shbernal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/translation-harness"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js"
    },
    "./batch": {
      "types": "./dist/batch/index.d.ts",
      "import": "./dist/batch/index.js"
    }
  },
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src test scripts examples && oxfmt --check src test scripts examples && pnpm run lint:text",
    "lint:text": "node scripts/check-no-emdash.ts",
    "lint:fix": "oxlint --type-aware --fix src test scripts examples",
    "format": "oxfmt src test scripts examples",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  }
}
